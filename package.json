{
  "name": "mi-portal-web-client",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cap:init": "cap init",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "build:mobile": "npm run build && cap sync android",
    "cockpit": "cross-env ELECTRON_RUN_AS_NODE= electron desktop/main.js",
    "widget": "cross-env ELECTRON_RUN_AS_NODE= npm run build && cross-env ELECTRON_RUN_AS_NODE= electron desktop/main.js",
    "widget:clean": "taskkill /F /IM electron.exe 2>nul || exit 0 && cross-env ELECTRON_RUN_AS_NODE= npm run build && cross-env ELECTRON_RUN_AS_NODE= electron desktop/main.js",
    "widget:dev": "cross-env ELECTRON_RUN_AS_NODE= electron desktop/main.js --dev-server"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@dagrejs/dagre": "^3.1.1",
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/typography": "^0.5.20",
    "@xyflow/react": "^12.12.0",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sweetalert2": "^11.17.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
